<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_property_type_tree" model="ir.ui.view">
        <field name="name">real.estate.property.type.tree</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_property_type_form" model="ir.ui.view">
        <field name="name">real.estate.property.type.form</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <div class="oe_button_box d-flex justify-content-end" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(action_property_offer)d" icon="fa-file" domain="[('property_type_id', '=', active_id)]">
                                <field string="Offer Count" name="offer_count" widget="statinfo"/>
                            </button>
                    </div>
                <sheet>

                    <field name="name"/>
                    <field name="property_ids">
                        <list>
                            <field name="name"/>
                            <field name="expected_price"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_property_type" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">real.estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>