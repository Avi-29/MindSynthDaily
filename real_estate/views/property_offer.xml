<odoo>
    <record id="view_property_offer_tree" model="ir.ui.view">
        <field name="name">real.estate.property.offer.list</field>
        <field name="model">real.estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="price"/>
                <field name="status"/>
                <field name="validity"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <record id="view_property_offer_form" model="ir.ui.view">
        <field name="name">real.estate.property.offer.form</field>
        <field name="model">real.estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_accept_offer" type="object" string="Accept" class="btn-primary"
                            invisible="'status'=='accepted'"/>

                    <button name="action_refuse_offer" type="object" string="Refuse" class="btn-secondary"
                            invisible="'status'=='refused'"/>
                </header>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="price"/>
                        <field name="status"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
