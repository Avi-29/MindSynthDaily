<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_property_list" model="ir.ui.view">
        <field name="name">real.estate.property.tree</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('offer_received', 'offer_accepted')"
                  decoration-muted="state == 'sold'"
                  decoration-bf="state == 'offer_accepted'">
                <field name="name"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_mark_sold" type="object" string="Mark as Sold" class="btn-primary"
                            invisible="state == 'sold' or state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"
                            invisible="state == 'sold' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <h2>
                        <field name="property_tag" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </h2>
                    <group>
                        <group>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                            <group>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Sales">
                            <group>
                                <field name="seller_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids">
                                <list decoration-danger="status == 'refused'" decoration-success="status == 'accepted'">
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real.estate.property.search</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <field name="is_available"/>
                <field name="living_area" filter_domain="[('living_area','>=',self)]"/>
                <filter name="available_filter" string="Available" domain="[('is_available','=',True)]"/>
                <filter name="unavailable_filter" string="Unavailable" domain="[('is_available','=',False)]"/>
            </search>
        </field>
    </record>
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real.estate.property.kanban</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" group_create="false">
                 <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div>Expected:
                                <field name="expected_price"/>
                            </div>
                            <t t-if="record.state.raw_value == 'offer_received'">
                                <div>Best:
                                    <field name="best_price"/>
                                </div>
                            </t>
                            <t t-if="record.state.raw_value == 'offer_accepted'">
                                <div>Sold:
                                    <field name="selling_price"/>
                                </div>
                            </t>
                            <field name="property_tag" widget="many2many_tags"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_property_search"/>
        <field name="context">{'search_default_available_filter': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first property</p>
        </field>
    </record>

    <menuitem id="menu_real_estate_root" name="Real Estate"/>
    <menuitem id="menu_property" name="Properties"
              parent="menu_real_estate_root"
              action="action_property"/>

</odoo>


