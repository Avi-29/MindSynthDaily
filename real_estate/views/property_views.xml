<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_property_list" model="ir.ui.view">
        <field name="name">real.estate.property.tree</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('offer_received', 'offer_accepted')"
                  decoration-muted="state == 'sold'"
                  decoration-bf="state == 'offer_accepted'">
                <field name="name"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_mark_sold" type="object" string="Mark as Sold" class="btn-primary"
                            invisible="state == 'sold' or state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"
                            invisible="state == 'sold' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <h2>
                        <field name="property_tag" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </h2>

                    <group>
                        <group>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                            <group>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Sales">
                            <group>
                                <field name="seller_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids">
                                <list decoration-danger="status == 'refused'" decoration-success="status == 'accepted'">
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real.estate.property.search</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <field name="is_available"/>
                <field name="living_area" filter_domain="[('living_area','>=',self)]"/>
                <filter name="available_filter" string="Available" domain="[('is_available','=',True)]"/>
                <filter name="unavailable_filter" string="Unavailable" domain="[('is_available','=',False)]"/>
            </search>
        </field>
    </record>
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real.estate.property.kanban</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" group_create="false" class="o_kanban_view">
                <field name="state"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card"
                             style="display: flex; align-items: center; gap: 15px; padding: 10px;">

                            <!-- LEFT: Property Image -->
                            <div>
                                <img t-att-src="kanban_image('real.estate.property', 'image', record.id.value)"
                                     alt="Property Image"
                                     style="height: 100px; width: 100px; object-fit: cover; border-radius: 8px; box-shadow: 0 0 6px rgba(0,0,0,0.2);"/>
                            </div>

                            <!-- RIGHT: Property Details -->
                            <div style="flex-grow: 1; display: flex; flex-direction: column; justify-content: center;">
                                <div>
                                    <strong style="font-size: 16px;">
                                        <field name="name"/>
                                    </strong>
                                </div>

                                <div style="margin-top: 4px;">
                                    <span style="font-weight: 500;">Expected:</span>
                                    <field name="expected_price"/>
                                </div>

                                <t t-if="record.state.raw_value == 'offer_received'">
                                    <div>
                                        <span style="font-weight: 500;">Best:</span>
                                        <field name="best_price"/>
                                    </div>
                                </t>
                                <t t-if="record.state.raw_value == 'offer_accepted'">
                                    <div>
                                        <span style="font-weight: 500;">Sold:</span>
                                        <field name="selling_price"/>
                                    </div>
                                </t>

                                <!-- Tags -->
                                <div style="margin-top: 6px;">
                                    <field name="property_tag" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_property_search"/>
        <field name="context">{'search_default_available_filter': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first property</p>
        </field>
    </record>
    <record id="view_report_property" model="ir.actions.report">
        <field name="name">Property Report example</field>
        <field name="model">real.estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate.real_estate_property_report</field>
        <field name="report_file">real_estate.real_estate_property_report</field>
        <field name="print_report_name">'Property - %s' % (object.name or 'object.company_id').replace('/','')</field>
        <field name="binding_model_id" ref="model_real_estate_property"/>
        <field name="binding_type">report</field>
    </record>



</odoo>


